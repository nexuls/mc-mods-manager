{
  "name": "mc-mod",
  "version": "0.0.0",
  "description": "Manage Minecraft mods and plugins from a local web UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexuls/mc-mods-manager.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "mc-mod": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "MC_MOD_DEV=1 bun --watch src/bin.ts --no-open --port 4719",
    "build": "bun build src/bin.ts --target=bun --outdir=dist --define process.env.NODE_ENV='\"production\"'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/express": "^5.0.6",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@mc-mod/shared": "workspace:*",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "express": "^5.2.1",
    "fflate": "^0.8.3",
    "open": "^11.0.4",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.8.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  }
}
