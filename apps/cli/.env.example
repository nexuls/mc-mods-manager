# Copy to .env.local (gitignored). Bun loads it automatically when running `bun run dev` in apps/cli.

# Instance directory to manage in development, instead of the current directory.
# MC_MOD_DIR=/path/to/.minecraft

# CurseForge API key for development (https://console.curseforge.com/). Wins over the key saved in Settings.
# CURSEFORGE_API_KEY=
